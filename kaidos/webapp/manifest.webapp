{
  "name": "KaDOS",
  "description": "16-bit DOS prototype (demo). Fallout 2 NOT supported.",
  "launch_path": "/index.html",
  "type": "privileged",
  "version": "0.2.45",
  "developer": {
    "name": "kaidos-project",
    "url": "https://example.com"
  },
  "default_locale": "en",
  "locales": {
    "en": {
      "name": "KaDOS",
      "description": "16-bit DOS prototype (demo)"
    },
    "ru": {
      "name": "KaDOS",
      "description": "Прототип эмулятора DOS 16-бит (демо)"
    }
  },
  "icons": {
    "128": "/img/icon-128.png",
    "512": "/img/icon-512.png"
  },
  "permissions": {
    "device-storage:sdcard": {
      "access": "readwrite"
    }
  },
  "activities": {
    "open": {
      "href": "/index.html",
      "disposition": "window",
      "filters": {
        "type": [
          "text/plain",
          "application/octet-stream",
          "application/x-msdos-program"
        ],
        "name": [
          "*.txt",
          "*.conf",
          "*.cfg",
          "*.bat",
          "*.ini",
          "*.asm",
          "*.nfo",
          "*.com",
          "*.bin"
        ]
      },
      "returnValue": true
    },
    "share": {
      "href": "/index.html",
      "disposition": "window",
      "filters": {
        "type": [
          "text/plain",
          "application/octet-stream",
          "application/x-msdos-program"
        ],
        "name": [
          "*.txt",
          "*.conf",
          "*.cfg",
          "*.bat",
          "*.ini",
          "*.asm",
          "*.nfo",
          "*.com",
          "*.bin"
        ]
      },
      "returnValue": true
    },
    "pick": {
      "href": "/index.html",
      "disposition": "window",
      "filters": {
        "type": [
          "text/plain",
          "application/octet-stream",
          "application/x-msdos-program"
        ],
        "name": [
          "*.txt",
          "*.conf",
          "*.cfg",
          "*.bat",
          "*.ini",
          "*.asm",
          "*.nfo",
          "*.com",
          "*.bin"
        ]
      },
      "returnValue": true
    }
  },
  "fullscreen": true,
  "orientation": [
    "portrait"
  ],
  "runtime_type": "gecko"
}